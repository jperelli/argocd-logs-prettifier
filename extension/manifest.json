{
  "manifest_version": 3,
  "name": "Argo CD Logs Prettifier",
  "version": "1.0.0",
  "description": "Structured, filterable view of JSON and logfmt log lines in the Argo CD pod Logs tab: level badges, filters, expandable records.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Argo CD Logs Prettifier: configure Argo CD URLs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
